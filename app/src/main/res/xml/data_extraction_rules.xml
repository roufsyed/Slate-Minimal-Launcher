<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="slate_prefs.xml" />
    </cloud-backup>

    <!--
      slate_device_prefs holds settings that must never leave this device (see
      PreferencesManager.devicePrefs). The cloud-backup section above already excludes it by
      omission, because a single <include> puts that section into allowlist mode. Device-to-
      device transfer needs its own rules: with no <device-transfer> section at all, D2D
      defaults to copying EVERYTHING, and backup_rules.xml is explicitly ignored for D2D once
      targetSdk is 31 or higher.

      Deliberately <exclude>-only. Adding even one <include> here would switch this section to
      allowlist mode across every domain, which would silently stop transferring filesDir/fonts
      (the custom TTF import) along with anything else unlisted. Exclude-only preserves the
      default of "everything except these".

      The .bak line is not redundant: SharedPreferences writes through a sibling
      "<name>.xml.bak" file, and exclude paths are matched by exact string equality rather than
      by prefix, so it would otherwise transfer whenever a write had been interrupted.
    -->
    <device-transfer>
        <exclude domain="sharedpref" path="slate_device_prefs.xml" />
        <exclude domain="sharedpref" path="slate_device_prefs.xml.bak" />
    </device-transfer>
</data-extraction-rules>
