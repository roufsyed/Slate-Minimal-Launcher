<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Mobile-data state for the Data quick-toggle widget. READ_BASIC_PHONE_STATE is "normal" on
         API 33+ (no runtime prompt). On older Android, the Data widget hides itself. -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <!-- Required ONLY when the user explicitly enables "Direct call" in
         Settings → Quick toggles. The runtime grant is requested from
         SettingsActivity at toggle-ON time, never at app start. With the
         setting off (default), CallShortcutWidget uses ACTION_DIAL and
         this permission is never exercised. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Required ONLY when the user explicitly enables "Search contacts" in
         Settings → Search. The runtime grant is requested at toggle-ON time
         after a consent dialog explains the privacy contract. With the toggle
         off (default), no contacts data is ever read; the manifest declaration
         is dormant. Contacts are queried ephemerally per keystroke, filtered
         in memory, and discarded - never stored, indexed, or transmitted. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Slate">

        <!--
            Recents-visibility contract for the launcher task.

            Goal: the Slate task NEVER appears in the system Overview screen. Slate is the
            HOME-role app; surfacing it in Recents is confusing and invites swipe-dismiss
            of the launcher itself.

            Per AOSP, a task's visibility in Overview is governed by the ROOT activity's
            excludeFromRecents. In practice that's not sufficient for a launcher because:
              (a) MainActivity.onCreate may finish() itself and hand off to OnboardingActivity
                  (default-launcher-not-yet-set path), which then transiently becomes the
                  task root.
              (b) Some OEM Overview implementations re-evaluate task visibility against the
                  currently foregrounded activity, surfacing the task whenever Settings or
                  Onboarding is on top - even though MainActivity (the root) is excluded.

            Defense in depth: every activity declares excludeFromRecents="true" AND
            taskAffinity="" so:
              (a) whichever activity ends up as the task root, the task stays hidden;
              (b) all activities share the same empty affinity, so they always co-locate
                  in MainActivity's task - no `am start` or stray FLAG_ACTIVITY_NEW_TASK
                  can fork a sibling Slate task that would be Recents-visible.

            clearTaskOnLaunch on MainActivity returns the launcher stack to a clean root
            on every HOME press. Onboarding state lives in prefs; MainActivity.onResume
            re-launches Onboarding if the completion flag is still false.

            Rule for any new activity in this app: declare android:excludeFromRecents="true"
            AND android:taskAffinity="" unless there is a deliberate reason not to.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:clearTaskOnLaunch="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="Welcome" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="Settings"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".SlateAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name=".SlateNotificationService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
